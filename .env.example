# Shipal MCP app — local env. Copy to .env and fill in.
# .env is gitignored (see .gitignore).

# Required: 17Track API key. Server refuses to boot without this.
SEVENTEEN_TRACK_API_KEY=

# Yavio analytics (@yavio/sdk). Leave YAVIO_API_KEY blank locally to disable
# (the SDK runs in no-op mode and track() does nothing).
# NOTE: set YAVIO_ENDPOINT explicitly — the SDK's built-in default
# (https://ingest.yavio.ai) does not resolve. The live ingest is:
YAVIO_ENDPOINT=https://ingest.apps.yavio.ai/v1/events
YAVIO_API_KEY=
